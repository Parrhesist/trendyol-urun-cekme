# /etc/systemd/system/saha-kenari.service
# Kurulum: sudo cp saha-kenari.service /etc/systemd/system/ && sudo systemctl enable --now saha-kenari
[Unit]
Description=Saha Kenari takim sunucusu
After=network.target

[Service]
WorkingDirectory=/opt/saha-kenari
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Environment=ANTRENOR_SIFRESI=buraya-guclu-bir-sifre
# Environment=IZLEME_SIFRESI=oyuncu-sifresi
User=www-data
Group=www-data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
